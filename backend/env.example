# Backend environment configuration
# Copy this file to `.env` and fill in real values. Never commit secrets.

# Express API
PORT=4000
NODE_ENV=development

# AWS credentials
AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
CAMERA_S3_BUCKET=drone-image-htc2025

# DynamoDB tables
DRONES_TABLE=drones
DRONE_IMAGES_TABLE=droneImages
USERS_TABLE=users
CAMERA_IMAGES_TABLE=cameraImages

